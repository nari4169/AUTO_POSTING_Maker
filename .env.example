# =============================================================================
#  .env.example  →  복사해서 .env 로 만든 뒤 값을 채우세요.
#
#      cp .env.example .env        (Windows: copy .env.example .env)
#
#  - .env 는 비밀번호/토큰이 들어가므로 절대 공유·업로드하지 마세요. (.gitignore 에 이미 제외돼 있습니다)
#  - 사용하지 않는 채널(Threads / Reels / 네이버)은 해당 구역을 비워 두면 됩니다.
#  - 값에 공백이 있어도 따옴표는 필요 없습니다.  예)  KEY=값 입니다
#  - 아래 값은 모두 "예시"입니다. 실제 값으로 바꿔야 동작합니다.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# 1) 공통
# ─────────────────────────────────────────────────────────────────────────────

# 글감 소스: json(내가 만든 content/posts.json) 또는 rss(블로그/뉴스 RSS 주소)
SOURCE_TYPE=json
# SOURCE_TYPE=json 일 때 글감 파일(없으면 content/posts.example.json 을 대신 읽습니다)
CONTENT_FILE=content/posts.json
# SOURCE_TYPE=rss 일 때 읽어 올 RSS 주소
RSS_URL=https://example.com/feed.xml

# 제휴(광고) 링크를 넣는 글에 자동으로 붙는 대가성 문구. 반드시 본인 상황에 맞게 고치세요.
AD_DISCLOSURE=이 포스팅은 제휴 마케팅 활동의 일환으로, 이에 따른 일정액의 수수료를 제공받을 수 있습니다.

# 실행 기록/중복 방지 DB, 로그, 임시 영상이 저장되는 폴더 (기본: 프로젝트 안의 data)
DATA_DIR=data


# ─────────────────────────────────────────────────────────────────────────────
# 2) AI 문구 생성 (선택) — Gemini 먼저, 실패/한도 초과면 Groq, 둘 다 안 되면 템플릿 문구
# ─────────────────────────────────────────────────────────────────────────────
# AI 를 끄고 템플릿 문구만 쓰려면 0
AI_ENABLED=1

# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# 모델 이름은 자주 바뀌고 옛 모델은 종료됩니다. 기본값은 "최신 Flash"를 가리키는 별칭입니다.
# 오류가 나면 공식 문서(https://ai.google.dev/gemini-api/docs/models)에서 현재 쓸 수 있는 모델명을 확인해 바꾸세요.
GEMINI_MODEL=gemini-flash-latest

# Groq(OpenAI 호환) 에서 발급: https://console.groq.com/keys  (키를 여러 개 쓰면 번갈아 사용)
GROQ_API_KEY=your-groq-api-key
# GROQ_API_KEY_1=your-second-groq-key
# GROQ_API_KEY_2=your-third-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1


# ─────────────────────────────────────────────────────────────────────────────
# 3) 실패 알림 메일 (선택) — 비워 두면 메일 없이 로그만 남깁니다
# ─────────────────────────────────────────────────────────────────────────────
# Gmail 이라면 "앱 비밀번호"를 발급해서 SMTP_PASSWORD 에 넣으세요. (계정 비밀번호 아님)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
MAIL_TO=you@example.com


# ─────────────────────────────────────────────────────────────────────────────
# 4) Threads  (threads/ 폴더)
#    발급 순서: README 의 "Threads 시작하기" 또는 책 3장 참고
# ─────────────────────────────────────────────────────────────────────────────
# Meta for Developers 앱의 Threads 설정 화면에서 확인
THREADS_APP_ID=1234567890
THREADS_APP_SECRET=your-threads-app-secret
# 앱에 등록한 "리디렉션 콜백 URL" 과 완전히 같아야 합니다 (https 필수)
THREADS_REDIRECT_URI=https://example.com/threads/callback

# 아래 두 값은 `python -m threads.oauth_helper exchange ... --save` 가 자동으로 채워 줍니다
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

THREADS_API_VERSION=v1.0
# 24시간 동안 게시할 수 있는 최대 글 수 (계정 보호용 안전장치)
THREADS_DAILY_LIMIT=10
# 자동 답글(threads.reply_comments)에서 AI 가 실패했을 때 쓰는 고정 문구(선택)
REPLY_TEXT=댓글 감사합니다!


# ─────────────────────────────────────────────────────────────────────────────
# 5) Instagram Reels  (reels/ 폴더)
# ─────────────────────────────────────────────────────────────────────────────
# Meta 앱 > Instagram > "API setup with Instagram login" 에서 토큰 생성 후 붙여 넣기
IG_ACCESS_TOKEN=
IG_USER_ID=
# Meta 는 API 버전을 주기적으로 올리고 오래된 버전은 종료합니다. 최신 버전은 공식 changelog 에서 확인하세요.
IG_API_VERSION=v25.0

# 영상 업로드 방식 — 인스타그램은 "인터넷에서 열 수 있는 영상 주소"를 요구합니다. 만든 영상을 잠깐 올려 두는 방법:
#   s3        S3 호환 저장소(Cloudflare R2 / AWS S3 / Backblaze B2 등)에 올림 (권장, 아래 S3_* 필요)
#   command   내가 정한 명령(rclone, scp 등)으로 올리고 공개 URL 을 출력하게 함 (REELS_UPLOAD_COMMAND 필요)
#   resumable (실험적) 인스타그램에 직접 전송 — 공식 문서상 지원 여부가 불확실, 위 둘이 안 될 때만 시도
REELS_UPLOAD_MODE=s3

# --- REELS_UPLOAD_MODE=s3 일 때 ---
# AWS S3 는 S3_ENDPOINT_URL 을 비워 두고, Cloudflare R2 는 https://<계정ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# 버킷을 "공개"로 설정했다면 그 공개 주소(끝의 / 제외). 비워 두면 1시간짜리 임시 주소를 만들어 사용합니다.
S3_PUBLIC_BASE_URL=
S3_PREFIX=reels/

# --- REELS_UPLOAD_MODE=command 일 때 ---
# {file} 은 영상 파일 경로로 바뀝니다. 명령의 "마지막 출력 줄"이 공개 URL 이어야 합니다.
# REELS_UPLOAD_COMMAND=/home/pi/bin/upload_video.sh {file}
# 게시 후 지우는 명령(선택). {url} 은 올린 주소로 바뀝니다.
# REELS_DELETE_COMMAND=/home/pi/bin/delete_video.sh {url}

# 영상 만들기 설정
REEL_LANG=ko
# 자막 글꼴(파이/리눅스: fonts-noto-cjk 설치 필요 → "Noto Sans CJK KR")
REEL_FONT=Noto Sans CJK KR
# 이미지가 없을 때 쓰는 배경색 (ffmpeg 색상 이름 또는 0xRRGGBB)
REEL_BG_COLOR=0x1b2a41
REEL_DAILY_LIMIT=5


# ─────────────────────────────────────────────────────────────────────────────
# 6) 네이버 블로그  (naver/ 폴더)
#    ※ 비밀번호는 저장하지 않습니다. login_setup.py 로 "사람이 직접" 한 번 로그인해서 세션만 저장합니다.
# ─────────────────────────────────────────────────────────────────────────────
# 블로그 주소 blog.naver.com/<여기> 의 아이디
NAVER_BLOG_ID=your-blog-id
# 로그인 세션 저장 파일
NAVER_STATE_PATH=data/naver_state.json
# 1 = 화면 없이 실행(일부 환경에서 봇으로 감지될 수 있어 파이에서는 xvfb-run + 0 권장)
NAVER_HEADLESS=0
# 한 번 실행에 올릴 최대 글 수
NAVER_MAX_POSTS=1
# 글 사이 대기(초). 너무 짧으면 계정 제한 위험
NAVER_POST_INTERVAL_SEC=120

# ─────────────────────────────────────────────────────────────────────────────
# 7) 생존 신고 (선택) — 파이가 꺼졌을 때를 알아채는 장치
# ─────────────────────────────────────────────────────────────────────────────
# healthchecks.io 같은 서비스에서 만든 "핑 주소". 정해진 시간 안에 신호가 안 오면 서비스가 메일로 알려 줍니다.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# ─────────────────────────────────────────────────────────────────────────────
# 8) (연습용) 새 채널 예제 — 텔레그램 (examples/telegram_post.py, 책 7장)
# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id
